FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy packages and service files
COPY packages /app/packages
COPY services /app/services

# Install dependencies
RUN pip install --no-cache-dir -e /app/packages/schemas \
    -e /app/packages/database \
    -e /app/packages/model-clients \
    -r /app/services/api-gateway/requirements.txt \
    email-validator

EXPOSE 8000

ENV PYTHONPATH=/app:/app/services/api-gateway:/app/packages/schemas:/app/packages/database:/app/packages/model-clients

CMD exec uvicorn services.api-gateway.main:app --host 0.0.0.0 --port ${PORT:-8000}
