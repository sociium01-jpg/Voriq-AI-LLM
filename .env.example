# Voriq AI System Configuration

# Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Secret Keys
JWT_SECRET=vorik_ai_jwt_super_secret_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Storage
POSTGRES_USER=vorik
POSTGRES_PASSWORD=vorik_secure_pass
POSTGRES_DB=vorik_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vorik:vorik_secure_pass@localhost:5432/vorik_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vorik-ai-artifacts
S3_REGION=us-east-1

# Self-Hosted Open-Weight Model Engine (vLLM / Ollama / Local AI)
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8000/v1
DEFAULT_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
FALLBACK_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
EMBEDDING_MODEL=BAAI/bge-m3

# Self-Hosted Image & Video Generation
IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
VIDEO_MODEL_ID=ali-vilab/text-to-video-ms-1.7b

# Gateway & Service URLs
API_GATEWAY_PORT=8000
API_GATEWAY_URL=http://localhost:8000
WEB_STUDIO_PORT=3000
ADMIN_DASHBOARD_PORT=3001
